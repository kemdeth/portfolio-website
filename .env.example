# Copy this file to `.env` for local development and fill in real values.
#
# IMPORTANT for production (Netlify):
#   All `VITE_` variables below are inlined into the build at build time.
#   Set them in the Netlify Dashboard (Site config -> Environment variables)
#   and trigger a new deploy, otherwise the public build will run without them.
#   The Admin Dashboard (/admin) is STRICTLY protected by a login (see below).

# --- Admin dashboard login (server-side secrets, never prefixed with VITE_) ---
# Credentials that gate /admin. Set these in the Netlify Dashboard.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# SESSION_SECRET=  # optional; if unset, sessions are signed with a key derived from ADMIN_PASSWORD

# --- Local dev URL (for netlify dev CLI) ---
URL=http://localhost:8888

# Google Gemini API key (for the "Ask Kem" AI chat widget).
# Get one free at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# "Not a Robot" protection (Cloudflare Turnstile)
# 1. Create a Turnstile widget: https://dash.cloudflare.com/?to=/:account/turnstile
# 2. VITE_TURNSTILE_SITE_KEY is PUBLIC — Vite inlines it into the browser bundle,
#    so it must be set at build time (Netlify Dashboard env or your local .env).
# 3. TURNSTILE_SECRET_KEY is SERVER-ONLY — validated by netlify/functions/contact.ts,
#    never prefix it with VITE_.
# For local development you can use Cloudflare's test keys (always pass):
#   site key  : 1x00000000000000000000AA
#   secret key: 1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Server-side secrets for netlify/functions/contact.ts ---
# Do NOT prefix these with VITE_ — they must never reach the browser.
# Set them in the Netlify Dashboard (Site config -> Environment variables).
#
# Supabase: create a project, run supabase/schema.sql in the SQL editor,
#   then copy the Project URL and Service role key (Settings -> API).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram: create a bot with @BotFather, get the bot token,
#   then send /start to your bot and run:
#     curl https://api.telegram.org/bot<TOKEN>/getUpdates
#   Copy your numeric chat.id into TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Supabase frontend read access (cross-device data sync) ---
# When set, the public site reads profile, skills, projects, certificates,
# and testimonials directly from Supabase instead of localStorage.
# This ensures all devices show the same up-to-date content.
# Use the "anon" (public) key — NOT the service role key.
# You must also uncomment the "Public read" RLS policies in supabase/schema.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
