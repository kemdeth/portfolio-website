# Copy this file to `.env` and fill in your real values.

# Admin login
VITE_ADMIN_EMAIL=admin@gmail.com
VITE_ADMIN_PASSWORD=@dminPa$$

# Google Gemini API key (for the "Ask Kem" AI chat widget)
# Get one at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# --- Server-side secrets for the Netlify contact function (netlify/functions/contact.ts) ---
# Do NOT prefix these with VITE_ — they must never reach the browser.
# Set them in the Netlify Dashboard (Site config -> Environment variables)
# and/or in your local .env for `netlify dev`.
#   - Supabase: create a project, run supabase/schema.sql in the SQL editor,
#     then copy the Project URL and the Service role key (Settings -> API).
#   - Telegram: create a bot with @BotFather, then send /start to your bot and run:
#       curl https://api.telegram.org/bot<TOKEN>/getUpdates
#     Copy your numeric chat.id into TELEGRAM_CHAT_ID.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
